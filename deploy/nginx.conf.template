server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options  "nosniff"                       always;
    add_header X-Frame-Options         "DENY"                          always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

    # ── SPA — toutes les routes vers index.html ─────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Assets statiques — cache long terme ─────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── Proxy vers le backend Vote (même conteneur, 127.0.0.1) ──────────────
    # resolver + $variable : résolution paresseuse, à la volée. Si le backend
    # n'est pas encore prêt, seul /api/* échoue (502) — le reste du site
    # (frontend) continue de fonctionner normalement.
    resolver 127.0.0.11 valid=10s ipv6=off;
    location /api/ {
        set $vote_upstream ${VOTE_API_TARGET};
        proxy_pass         $vote_upstream/;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
    }
}
