VOTE_PORT=4300
VOTE_JWT_SECRET=change-me-in-production
VOTE_DB_PATH=./vote.db

# Utilisés uniquement par `npm run seed:admin`
VOTE_ADMIN_USERNAME=admin_vote
VOTE_ADMIN_PASSWORD=ChangeMe2026!
VOTE_ADMIN_NAME=Administrateur Vote

# Connexion Microsoft (Entra ID) — optionnelle : si absentes, le bouton
# "Se connecter avec Microsoft" renvoie une erreur 503 mais le login
# classique (identifiant/mot de passe) continue de fonctionner normalement.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4300/auth/microsoft/callback
