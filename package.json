{
  "name": "vote-deg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix server run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix server install",
    "seed:admin": "npm --prefix server run seed:admin",
    "migrate:turso": "node scripts/migrate-to-turso.mjs",
    "import:employees": "node scripts/import-employees.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@vercel/blob": "^0.27.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "xlsx": "^0.18.5"
  }
}
