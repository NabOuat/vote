{
  "name": "vote-deg",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix server run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix frontend install && npm --prefix server install",
    "seed:admin": "npm --prefix server run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
